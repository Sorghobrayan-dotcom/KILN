# Vercel bundles every file it can reach and does no tree shaking for Python,
# so everything the function does not need is excluded here. This is about cold
# start weight, not about clearing a limit: the Python bundle ceiling is 500 MB
# uncompressed and the runtime dependencies come to roughly 80 MB.
.venv/
.cache/
.pytest_cache/
__pycache__/
*.pyc

.git/
.env

tests/
scripts/
docs/
examples/
Dockerfile
DEPLOY.md
*.png
