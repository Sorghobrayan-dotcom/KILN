# Kiln configuration. Copy to .env and fill in what you have.
#
# Every line here is optional. With this file empty, Kiln still runs and still
# generates real media: the `art` kind uses Pollinations, which needs no
# credential at all. Each key you add lights up more kinds, GET /api/kinds
# always says what is enabled and what is missing.

# --- Backblaze B2 -------------------------------------------------------
# backblaze.com > B2 Cloud Storage > Buckets, then Application Keys.
# Make the bucket PUBLIC: Genblaze hands out credential-free asset URLs, and a
# private bucket means every picture in the gallery is a dead link.
# Without these, Kiln keeps everything in memory, fine for a look around,
# useless for the point of the project, because nothing survives a restart.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=kiln-assets
# Must match the bucket's region exactly. It is shown on the bucket page.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# --- Media providers ----------------------------------------------------
# ElevenLabs: free tier, 10k credits/month, no card. Unlocks `voice` and `sfx`.
# elevenlabs.io > avatar (bottom left) > API Keys > Create API Key
ELEVENLABS_API_KEY=

# GMI Cloud: paid. Unlocks `video` (Veo3-Fast) and `image` (reve-remix).
# Leave empty and those kinds stay greyed out with the reason shown.
GMI_API_KEY=

# --- Kiln ---------------------------------------------------------------
# Protects mutations. Reads never need it, so a judge can inspect provenance
# and manifests without one. Publish this value as the test credential.
KILN_TOKEN=kiln-demo-2026
